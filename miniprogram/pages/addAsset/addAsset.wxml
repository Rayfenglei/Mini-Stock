<view class="container">
  <view class="section-title">选择资产类型</view>
  <asset-selector
    id="assetSelector"
    assetType="{{assetType}}"
    bind:change="onAssetTypeChange"
    bind:search="onSearch"
    bind:select="onAssetSelect"
  />

  <!-- 基金添加界面 -->
  <block wx:if="{{assetType === 'fund'}}">
    <!-- 错误提示 -->
    <view class="error-banner" wx:if="{{showError}}">
      <text class="error-text">{{errorMsg}}</text>
      <text class="error-close" bindtap="onCloseError">✕</text>
    </view>

    <view class="section-title">基金快速添加</view>
    <view class="form-card">
      <!-- 基金代码 -->
      <view class="form-item">
        <text class="form-label">基金代码</text>
        <input
          class="form-input"
          type="number"
          maxlength="6"
          placeholder="请输入6位基金代码"
          value="{{fundForm.code}}"
          bindinput="onFundCodeInput"
        />
      </view>
      <text class="form-hint" wx:if="{{fundForm.name}}">{{fundForm.name}}</text>

      <!-- 持仓份额 -->
      <view class="form-item">
        <text class="form-label">持仓份额</text>
        <input
          class="form-input"
          type="digit"
          placeholder="请输入当前持仓份额"
          value="{{fundForm.shares}}"
          bindinput="onFundSharesInput"
        />
      </view>
      <text class="form-hint">根据持仓份额和当日净值自动计算持仓价值</text>

      <!-- 投资金额（可选） -->
      <view class="form-item">
        <text class="form-label">投资金额（元）<text class="label-optional">（可选）</text></text>
        <input
          class="form-input"
          type="digit"
          placeholder="记录实际投入金额"
          value="{{fundForm.amount}}"
          bindinput="onFundAmountInput"
        />
      </view>
      <text class="form-hint">用于记录实际投入金额，可不填</text>

      <!-- 计算按钮 -->
      <view class="calc-btn-wrapper">
        <button class="btn-calc" bindtap="calculateFundShares" disabled="{{loading}}">
          <text wx:if="{{loading}}">{{loadingText}}</text>
          <text wx:else>🔍 查询净值并计算价值</text>
        </button>
      </view>

      <!-- 计算结果显示 -->
      <view class="calc-result" wx:if="{{showCalcResult}}">
        <view class="result-header">
          <text class="result-title">计算结果</text>
        </view>
        <view class="result-item">
          <text class="result-label">持仓份额</text>
          <text class="result-value">{{calcShares}} 份</text>
        </view>
        <view class="result-item">
          <text class="result-label">当日净值</text>
          <text class="result-value">¥{{calcNetValue}}</text>
        </view>
        <view class="result-item highlight">
          <text class="result-label">持仓价值</text>
          <text class="result-value">¥{{calcHoldingValue}}</text>
        </view>
        <view class="formula-hint">
          <text>计算公式：持仓价值 = 持仓份额 × 当日净值</text>
        </view>
      </view>

      <!-- 提交按钮 -->
      <view class="submit-btn-wrapper" wx:if="{{showCalcResult}}">
        <button class="btn-primary" bindtap="submitFundHolding">✓ 确认添加</button>
      </view>
    </view>

    <!-- 使用说明 -->
    <view class="tips-card">
      <view class="tips-title">📋 使用说明</view>
      <view class="tips-item">• 输入6位基金代码自动查询基金名称</view>
      <view class="tips-item">• 输入当前持仓份额</view>
      <view class="tips-item">• 系统自动获取当日净值并计算持仓价值</view>
      <view class="tips-item">• 投资金额为可选项，用于记录实际投入</view>
      <view class="tips-item">• 计算公式：持仓价值 = 持仓份额 × 当日净值</view>
    </view>
  </block>

  <!-- 股票添加界面 -->
  <block wx:if="{{assetType === 'stock'}}">
    <view class="section-title">持仓信息</view>
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">股票代码</text>
        <input
          class="form-input"
          type="number"
          maxlength="6"
          placeholder="请输入6位股票代码"
          value="{{stockInputCode}}"
          bindinput="onStockCodeInput"
        />
      </view>
      <text class="form-hint" wx:if="{{formData.assetName}}">{{formData.assetName}}</text>
      <view class="form-item">
        <text class="form-label">持有份额</text>
        <input class="form-input" type="digit" placeholder="输入份额" value="{{formData.shares}}" bindinput="onSharesInput" />
      </view>
      <view class="form-item">
        <text class="form-label">成本价（元）</text>
        <input class="form-input" type="digit" placeholder="输入成本价" value="{{formData.costPrice}}" bindinput="onPriceInput" />
      </view>
      <view class="form-item readonly">
        <text class="form-label">持仓成本</text>
        <text class="form-value">¥{{costAmountDisplay}}（自动计算）</text>
      </view>
    </view>

    <view class="submit-btn-wrapper">
      <button class="btn-primary" bindtap="submitHolding">确认添加</button>
    </view>
  </block>

  <!-- 黄金添加界面 -->
  <block wx:if="{{assetType === 'gold'}}">
    <view class="section-title">持仓信息</view>
    <view class="form-card">
      <view class="form-item">
        <text class="form-label">持有克数</text>
        <input class="form-input" type="digit" placeholder="输入克数" value="{{formData.shares}}" bindinput="onSharesInput" />
      </view>
      <view class="form-item">
        <text class="form-label">成本价（元/克）</text>
        <input class="form-input" type="digit" placeholder="输入成本价" value="{{formData.costPrice}}" bindinput="onPriceInput" />
      </view>
      <view class="form-item readonly">
        <text class="form-label">持仓成本</text>
        <text class="form-value">¥{{costAmountDisplay}}（自动计算）</text>
      </view>
    </view>

    <view class="submit-btn-wrapper">
      <button class="btn-primary" bindtap="submitHolding">确认添加</button>
    </view>
  </block>
</view>
