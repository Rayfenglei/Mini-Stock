.section-title {
  font-size: 32rpx;
  font-weight: bold;
  padding: 30rpx 40rpx 20rpx;
}

.form-card {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item.readonly {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.form-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #1A73E8;
}

.submit-btn-wrapper {
  padding: 40rpx;
  padding-bottom: 80rpx;
}
