<view class="container">
  <!-- 用户信息卡片 -->
  <view class="user-card card-gradient">
    <view class="user-header">
      <view class="user-avatar">
        <text class="avatar-text">{{userInfo.nickName ? userInfo.nickName[0] : '👤'}}</text>
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName || '微信用户'}}</text>
        <text class="user-id">ID: {{userInfo.displayId || '未登录'}}</text>
      </view>
      <view class="settings-btn" bindtap="onSettingsTap">
        <text class="settings-icon">⚙️</text>
      </view>
    </view>
    
    <!-- 统计概览 -->
    <view class="user-stats">
      <view class="stat-item">
        <text class="stat-value">{{stats.holdingCount || 0}}</text>
        <text class="stat-label">持仓数量</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.transactionCount || 0}}</text>
        <text class="stat-label">交易次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{stats.accountDays || 1}}</text>
        <text class="stat-label">使用天数</text>
      </view>
    </view>
  </view>

  <!-- 资产概览 -->
  <view class="section-card card">
    <view class="section-header">
      <view class="section-icon asset">
        <text>💰</text>
      </view>
      <text class="section-title">资产管理</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToAccounts">
        <view class="menu-left">
          <view class="menu-icon account">
            <text>🏦</text>
          </view>
          <text class="menu-text">我的账户</text>
        </view>
        <view class="menu-right">
          <text class="menu-badge">{{accountCount}}个</text>
          <text class="menu-arrow">→</text>
        </view>
      </view>
      <view class="menu-item" bindtap="goToTransactions">
        <view class="menu-left">
          <view class="menu-icon transaction">
            <text>📋</text>
          </view>
          <text class="menu-text">交易记录</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">→</text>
        </view>
      </view>
      <view class="menu-item" bindtap="goToReminders">
        <view class="menu-left">
          <view class="menu-icon reminder">
            <text>🔔</text>
          </view>
          <text class="menu-text">智能提醒</text>
        </view>
        <view class="menu-right">
          <text class="menu-badge" wx:if="{{reminderCount > 0}}">{{reminderCount}}条</text>
          <text class="menu-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 数据分析 -->
  <view class="section-card card">
    <view class="section-header">
      <view class="section-icon analysis">
        <text>📊</text>
      </view>
      <text class="section-title">数据分析</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToAnalysis">
        <view class="menu-left">
          <view class="menu-icon chart">
            <text>📈</text>
          </view>
          <text class="menu-text">资产分析</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">→</text>
        </view>
      </view>
      <view class="menu-item" bindtap="goToProfitStats">
        <view class="menu-left">
          <view class="menu-icon profit">
            <text>💹</text>
          </view>
          <text class="menu-text">盈亏统计</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">→</text>
        </view>
      </view>
      <view class="menu-item" bindtap="goToExport">
        <view class="menu-left">
          <view class="menu-icon export">
            <text>📤</text>
          </view>
          <text class="menu-text">导出报表</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 系统设置 -->
  <view class="section-card card">
    <view class="section-header">
      <view class="section-icon settings">
        <text>⚙️</text>
      </view>
      <text class="section-title">系统设置</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToRefreshSettings">
        <view class="menu-left">
          <view class="menu-icon refresh">
            <text>🔄</text>
          </view>
          <text class="menu-text">数据刷新设置</text>
        </view>
        <view class="menu-right">
          <text class="menu-desc">{{refreshInterval}}分钟</text>
          <text class="menu-arrow">→</text>
        </view>
      </view>
      <view class="menu-item" bindtap="goToColorSettings">
        <view class="menu-left">
          <view class="menu-icon color">
            <text>🎨</text>
          </view>
          <text class="menu-text">涨跌颜色设置</text>
        </view>
        <view class="menu-right">
          <text class="menu-desc">{{colorScheme === 'red-green' ? '红涨绿跌' : '绿涨红跌'}}</text>
          <text class="menu-arrow">→</text>
        </view>
      </view>
      <view class="menu-item" bindtap="goToNotificationSettings">
        <view class="menu-left">
          <view class="menu-icon notification">
            <text>🔔</text>
          </view>
          <text class="menu-text">通知设置</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 关于与帮助 -->
  <view class="section-card card">
    <view class="section-header">
      <view class="section-icon about">
        <text>❓</text>
      </view>
      <text class="section-title">关于与帮助</text>
    </view>
    <view class="menu-list">
      <view class="menu-item" bindtap="goToHelp">
        <view class="menu-left">
          <view class="menu-icon help">
            <text>📖</text>
          </view>
          <text class="menu-text">使用帮助</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">→</text>
        </view>
      </view>
      <view class="menu-item" bindtap="goToFeedback">
        <view class="menu-left">
          <view class="menu-icon feedback">
            <text>💬</text>
          </view>
          <text class="menu-text">意见反馈</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow">→</text>
        </view>
      </view>
      <view class="menu-item" bindtap="goToAbout">
        <view class="menu-left">
          <view class="menu-icon about-app">
            <text>ℹ️</text>
          </view>
          <text class="menu-text">关于我们</text>
        </view>
        <view class="menu-right">
          <text class="menu-desc">v{{appVersion}}</text>
          <text class="menu-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部间距 -->
  <view style="height: 40rpx;"></view>
</view>
