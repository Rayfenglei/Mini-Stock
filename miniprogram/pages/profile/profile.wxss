/* ============================================
   个人中心页样式 - 现代金融投资风格
   ============================================ */

.container {
  min-height: 100vh;
  background-color: var(--bg-primary);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ---------- 用户信息卡片 ---------- */
.user-card {
  margin: 32rpx;
  padding: 40rpx 36rpx;
  position: relative;
  overflow: hidden;
}

.user-card::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.user-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  position: relative;
  z-index: 1;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
}

.avatar-text {
  font-size: 48rpx;
  color: #fff;
  font-weight: 600;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  font-family: 'SF Mono', monospace;
}

.settings-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings-btn:active {
  background: rgba(255, 255, 255, 0.25);
}

.settings-icon {
  font-size: 32rpx;
}

/* 统计概览 */
.user-stats {
  display: flex;
  justify-content: space-around;
  position: relative;
  z-index: 1;
  padding-top: 32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.15);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ---------- 分区卡片 ---------- */
.section-card {
  margin: 0 32rpx 24rpx;
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--gray-100);
}

.section-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 32rpx;
}

.section-icon.asset {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
}

.section-icon.analysis {
  background: linear-gradient(135deg, #DBEAFE 0%, #93C5FD 100%);
}

.section-icon.settings {
  background: linear-gradient(135deg, #E0E7FF 0%, #A5B4FC 100%);
}

.section-icon.about {
  background: linear-gradient(135deg, #F3E8FF 0%, #D8B4FE 100%);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* ---------- 菜单列表 ---------- */
.menu-list {
  padding: 8rpx 0;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  transition: background 0.2s ease;
}

.menu-item:active {
  background: var(--gray-50);
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  font-size: 32rpx;
}

.menu-icon.account {
  background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%);
}

.menu-icon.transaction {
  background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%);
}

.menu-icon.reminder {
  background: linear-gradient(135deg, #FEE2E2 0%, #FECACA 100%);
}

.menu-icon.chart {
  background: linear-gradient(135deg, #E0E7FF 0%, #C7D2FE 100%);
}

.menu-icon.profit {
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
}

.menu-icon.export {
  background: linear-gradient(135deg, #F3E8FF 0%, #E9D5FF 100%);
}

.menu-icon.refresh {
  background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%);
}

.menu-icon.color {
  background: linear-gradient(135deg, #FDF2F8 0%, #FCE7F3 100%);
}

.menu-icon.notification {
  background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%);
}

.menu-icon.help {
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
}

.menu-icon.feedback {
  background: linear-gradient(135deg, #ECFDF5 0%, #D1FAE5 100%);
}

.menu-icon.about-app {
  background: linear-gradient(135deg, #F3F4F6 0%, #E5E7EB 100%);
}

.menu-text {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-badge {
  font-size: 22rpx;
  color: var(--text-tertiary);
  background: var(--gray-100);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-right: 16rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-right: 16rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
  font-weight: 300;
}
