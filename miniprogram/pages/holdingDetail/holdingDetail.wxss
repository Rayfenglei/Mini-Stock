.container {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.holding-header {
  padding: 20rpx 30rpx;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.asset-title {
  display: flex;
  align-items: center;
}

.asset-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-left: 10rpx;
}

.asset-code {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.current-price {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.current-price text:first-child {
  font-size: 32rpx;
  font-weight: bold;
}

.current-price text:last-child {
  font-size: 22rpx;
  margin-top: 2rpx;
}

.up { color: #E64340; }
.down { color: #00A650; }

.card {
  margin: 20rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 26rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #333;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-label {
  font-size: 24rpx;
  color: #666;
  width: 120rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
  width: 150rpx;
  flex-shrink: 0;
  text-align: right;
  padding-left: 20rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  padding: 20rpx 30rpx 12rpx;
  color: #333;
}

.transaction-item {
  margin: 0 20rpx 12rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.transaction-date {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.transaction-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.transaction-type {
  font-size: 24rpx;
  font-weight: 500;
}

.transaction-type.buy { color: #E64340; }
.transaction-type.sell { color: #00A650; }

.transaction-detail {
  font-size: 22rpx;
  color: #666;
}

.empty-transactions {
  text-align: center;
  padding: 40rpx;
}

.empty-text {
  font-size: 24rpx;
  color: #999;
}

.action-btns {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 30rpx 40rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  border: none;
  font-weight: 500;
}

.action-btn::after {
  border: none;
}

.action-btn.edit {
  background: #1A73E8;
  color: #fff;
}

.action-btn.add {
  background: #81C784;
  color: #fff;
}
