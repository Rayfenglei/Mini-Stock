/* ============================================
   分析页样式 - 现代金融投资风格
   ============================================ */

.container {
  min-height: 100vh;
  background-color: var(--bg-primary);
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* ---------- 页面标题 ---------- */
.page-header {
  padding: 40rpx 32rpx 24rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--text-secondary);
}

/* ---------- 时间选择器 ---------- */
.time-selector {
  display: flex;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.time-option {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  background: var(--bg-secondary);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  box-shadow: var(--shadow-sm);
}

.time-option.active {
  background: linear-gradient(135deg, var(--primary-500) 0%, var(--primary-600) 100%);
  color: #fff;
  box-shadow: 0 4rpx 14rpx rgba(59, 130, 246, 0.4);
}

/* ---------- 收益概览卡片 ---------- */
.overview-card {
  margin: 0 32rpx 24rpx;
  padding: 36rpx;
  position: relative;
  overflow: hidden;
}

.overview-card::before {
  content: '';
  position: absolute;
  top: -30%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.overview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}

.overview-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.date-range {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.overview-main {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}

.overview-item {
  display: flex;
  flex-direction: column;
}

.overview-item.right {
  align-items: flex-end;
}

.overview-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 12rpx;
}

.overview-value {
  font-size: 52rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
}

.overview-value.up {
  color: #fff;
}

.overview-value.down {
  color: #fff;
}

.overview-rate {
  font-size: 36rpx;
  font-weight: 700;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

.overview-rate.up {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

.overview-rate.down {
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
}

/* 迷你走势图 */
.mini-trend {
  height: 120rpx;
  position: relative;
  z-index: 1;
}

.trend-canvas {
  width: 100%;
  height: 100%;
}

/* ---------- 关键指标网格 ---------- */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 32rpx;
  margin-bottom: 24rpx;
}

.metric-card {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
}

.metric-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  font-size: 32rpx;
  background: var(--gray-100);
}

.metric-icon.up {
  background: var(--rise-light);
}

.metric-icon.down {
  background: var(--fall-light);
}

.metric-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 8rpx;
}

.metric-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.metric-rate {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.metric-rate.up {
  color: var(--rise-color);
}

.metric-rate.down {
  color: var(--fall-color);
}

/* ---------- 资产分布图表区域 ---------- */
.distribution-section {
  margin: 0 32rpx 24rpx;
}

/* ---------- 持仓排行 ---------- */
.ranking-card {
  margin: 0 32rpx 24rpx;
  overflow: hidden;
}

.ranking-card .card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--gray-100);
}

.ranking-card .card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.rank-tabs {
  display: flex;
  background: var(--gray-100);
  border-radius: 24rpx;
  padding: 4rpx;
}

.rank-tab {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  border-radius: 20rpx;
  font-weight: 500;
}

.rank-tab.active {
  background: var(--bg-secondary);
  color: var(--primary-600);
  box-shadow: var(--shadow-sm);
}

.ranking-list {
  padding: 0 32rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--gray-100);
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-number {
  width: 48rpx;
  height: 48rpx;
  background: var(--gray-100);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-right: 20rpx;
}

.rank-item:nth-child(1) .rank-number {
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #fff;
}

.rank-item:nth-child(2) .rank-number {
  background: linear-gradient(135deg, #C0C0C0 0%, #A0A0A0 100%);
  color: #fff;
}

.rank-item:nth-child(3) .rank-number {
  background: linear-gradient(135deg, #CD7F32 0%, #B87333 100%);
  color: #fff;
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.rank-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.rank-code {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-family: 'SF Mono', monospace;
}

.rank-value {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.rank-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.rank-rate {
  font-size: 24rpx;
  font-weight: 500;
}

.rank-rate.up {
  color: var(--rise-color);
}

.rank-rate.down {
  color: var(--fall-color);
}

/* ---------- 风险提示 ---------- */
.risk-card {
  margin: 0 32rpx 24rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%);
  border: 1rpx solid #FDE68A;
}

.risk-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.risk-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.risk-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #B45309;
}

.risk-text {
  font-size: 26rpx;
  color: #92400E;
  line-height: 1.6;
}
