.container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.form-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 20rpx;
}

.form-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.form-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  min-width: 120rpx;
}

.form-input {
  font-size: 26rpx;
  color: #333;
  text-align: right;
  flex: 1;
  padding-left: 20rpx;
}

.form-value {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.placeholder {
  color: #999;
}

.form-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
  line-height: 1.4;
}

.form-picker {
  font-size: 26rpx;
  color: #333;
  text-align: right;
  flex: 1;
  padding-left: 20rpx;
}

.form-picker.placeholder {
  color: #999;
}

.error-message {
  color: #ff4d4f;
  font-size: 22rpx;
  margin-bottom: 20rpx;
  padding: 0 12rpx;
}

.action-btns {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0 40rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  border: none;
  font-weight: 500;
}

.action-btn::after {
  border: none;
}

.action-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.action-btn.save {
  background: #1A73E8;
  color: #fff;
}