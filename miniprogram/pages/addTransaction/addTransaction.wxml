<view class="container">
  <view class="form-card">
    <view class="form-item">
      <text class="form-label">交易类型</text>
      <view class="radio-group">
        <radio-group bindchange="onTypeChange">
          <label class="radio-item">
            <radio value="buy" checked="{{formData.type === 'buy'}}" />
            <text>买入</text>
          </label>
          <label class="radio-item">
            <radio value="sell" checked="{{formData.type === 'sell'}}" />
            <text>卖出</text>
          </label>
        </radio-group>
      </view>
    </view>
    
    <view class="form-item">
      <text class="form-label">交易数量</text>
      <input class="form-input" type="number" value="{{formData.shares}}" bindinput="onSharesChange" placeholder="请输入交易数量" placeholder-class="placeholder" />
    </view>
    
    <view class="form-item">
      <text class="form-label">交易价格</text>
      <input class="form-input" type="number" value="{{formData.price}}" bindinput="onPriceChange" placeholder="请输入交易价格" placeholder-class="placeholder" />
    </view>
    
    <view class="form-item">
      <text class="form-label">交易金额</text>
      <text class="form-value">¥{{formData.amount}}</text>
    </view>
  </view>
  
  <view class="error-message" wx:if="{{errorMessage}}">{{errorMessage}}</view>
  
  <view class="action-btns">
    <button class="action-btn cancel" bindtap="onCancel">取消</button>
    <button class="action-btn submit" bindtap="onSubmit">提交</button>
  </view>
</view>