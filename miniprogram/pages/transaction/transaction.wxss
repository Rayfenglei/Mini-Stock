.filter-bar {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: #fff;
}

.filter-item {
  flex: 1;
  height: 70rpx;
  line-height: 70rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 35rpx;
  font-size: 26rpx;
  color: #666;
}

.date-group {
  margin-bottom: 20rpx;
}

.date-header {
  font-size: 28rpx;
  font-weight: bold;
  padding: 20rpx 30rpx;
  color: #666;
}

.transaction-card {
  margin: 0 20rpx 10rpx;
  padding: 25rpx 30rpx;
  background: #fff;
  border-radius: 12rpx;
}

.transaction-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.transaction-type {
  font-size: 28rpx;
  font-weight: bold;
}

.transaction-type.buy { color: #E64340; }
.transaction-type.sell { color: #00A650; }

.transaction-asset {
  display: flex;
  align-items: center;
}

.asset-name {
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 10rpx;
}

.asset-code {
  font-size: 24rpx;
  color: #999;
}

.transaction-body {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.transaction-detail {
  font-size: 26rpx;
  color: #666;
}

.transaction-fee {
  font-size: 24rpx;
  color: #999;
}

.transaction-footer {
  padding-top: 10rpx;
  border-top: 1rpx solid #eee;
}

.transaction-total {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

.fab-btn {
  position: fixed;
  bottom: 80rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: #1A73E8;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(26, 115, 232, 0.4);
}

.fab-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
}
