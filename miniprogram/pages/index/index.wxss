.total-assets-card {
  margin: 20rpx 40rpx;
  background: linear-gradient(135deg, #1A73E8 0%, #4A90E2 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 115, 232, 0.3);
}

.assets-header {
  margin-bottom: 24rpx;
}

.assets-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.assets-body {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.assets-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.assets-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.assets-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.assets-value.profit {
  color: #52c41a;
}

.assets-value.loss {
  color: #ff4d4f;
}

.assets-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
}

.add-asset-btn-wrapper {
  display: flex;
  justify-content: center;
  padding: 30rpx 40rpx;
}

.add-asset-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1A73E8 0%, #4A90E2 100%);
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 115, 232, 0.3);
  transition: all 0.2s ease;
}

.add-asset-btn:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 20rpx rgba(26, 115, 232, 0.4);
}

.add-icon {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 12rpx;
  line-height: 1;
}

.add-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  padding: 30rpx 40rpx 20rpx;
  color: #333;
}

.recent-holdings {
  padding: 0 40rpx;
}

.holding-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.holding-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.holding-info {
  display: flex;
  flex-direction: column;
}

.holding-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.holding-code {
  font-size: 24rpx;
  color: #999;
}

.holding-type {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
}

.holding-type.stock {
  background: #ff6b6b;
}

.holding-type.fund {
  background: #4ecdc4;
}

.holding-type.gold {
  background: #ffd93d;
  color: #333;
}

.holding-body {
  display: flex;
  justify-content: space-between;
}

.holding-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.holding-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.holding-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #ccc;
}
