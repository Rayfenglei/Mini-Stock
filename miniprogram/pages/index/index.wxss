.total-assets-card {
  margin: 20rpx 40rpx;
  background: linear-gradient(135deg, #1A73E8 0%, #4A90E2 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 115, 232, 0.3);
}

.assets-header {
  margin-bottom: 24rpx;
}

.assets-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.assets-body {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.assets-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.assets-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 12rpx;
}

.assets-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
}

.assets-value.profit {
  color: #E64340;
}

.assets-value.loss {
  color: #00A650;
}

.assets-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 20rpx;
}

.add-asset-btn-wrapper {
  display: flex;
  justify-content: center;
  padding: 30rpx 40rpx;
}

.add-asset-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1A73E8 0%, #4A90E2 100%);
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 115, 232, 0.3);
  transition: all 0.2s ease;
}

.add-asset-btn:active {
  transform: scale(0.98);
  box-shadow: 0 6rpx 20rpx rgba(26, 115, 232, 0.4);
}

.add-icon {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-right: 12rpx;
  line-height: 1;
}

.add-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.sort-btn {
  background: rgba(82, 196, 26, 0.12);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
}

.sort-text {
  font-size: 24rpx;
  color: #52c41a;
  font-weight: 500;
}

.recent-holdings {
  padding: 0 24rpx;
}

.holding-card-wrapper {
  position: relative;
  margin-bottom: 24rpx;
  overflow: hidden;
  border-radius: 20rpx;
  width: 100%;
}

.holding-card {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06), 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: stretch;
  width: 100%;
  z-index: 2;
  will-change: transform;
  overflow: hidden;
}

.holding-card.animating {
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.card-accent-bar {
  position: absolute;
  left: 0;
  top: 0;
  width: 6rpx;
  height: 100%;
  z-index: 3;
}

.holding-content {
  flex: 1;
  padding: 28rpx 32rpx;
  min-width: 0;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.asset-identity {
  display: flex;
  flex-direction: column;
}

.asset-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
  letter-spacing: 0.5rpx;
}

.asset-code {
  font-size: 24rpx;
  color: #999999;
  font-family: 'SF Mono', 'Menlo', monospace;
}

.update-badge {
  background: linear-gradient(135deg, rgba(82, 196, 26, 0.08) 0%, rgba(115, 209, 61, 0.08) 100%);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(82, 196, 26, 0.15);
}

.update-text {
  font-size: 20rpx;
  color: #52c41a;
  font-weight: 500;
}

.main-metrics {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 24rpx;
}

.metric-group {
  display: flex;
  flex-direction: column;
}

.metric-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
  font-weight: 400;
}

.metric-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: -0.5rpx;
}

.metric-value.primary {
  font-size: 40rpx;
}

.metric-value.profit {
  color: #E64340;
}

.metric-value.loss {
  color: #00A650;
}

.today-profit {
  align-items: flex-end;
}

.today-profit-value {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.metric-rate {
  font-size: 26rpx;
  font-weight: 600;
}

.metric-rate.profit {
  color: #E64340;
}

.metric-rate.loss {
  color: #00A650;
}

.divider-dotted {
  height: 1rpx;
  background: repeating-linear-gradient(
    to right,
    #e8e8e8 0,
    #e8e8e8 8rpx,
    transparent 8rpx,
    transparent 16rpx
  );
  margin: 24rpx 0;
}

.detail-metrics {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 12rpx;
}

.detail-item {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.detail-label {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 10rpx;
  white-space: nowrap;
}

.detail-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.detail-value.profit {
  color: #E64340;
}

.detail-value.loss {
  color: #00A650;
}

.detail-rate {
  font-size: 22rpx;
  font-weight: 500;
}

.detail-rate.profit {
  color: #E64340;
}

.detail-rate.loss {
  color: #00A650;
}

.profit-bar {
  width: 100%;
  height: 6rpx;
  background: #f0f0f0;
  border-radius: 3rpx;
  overflow: hidden;
  margin-top: 8rpx;
}

.profit-bar-fill {
  height: 100%;
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #ccc;
}

.delete-btn {
  position: absolute;
  right: 0;
  top: 0;
  width: 160rpx;
  height: 100%;
  min-width: 160rpx;
  background: #ff4d4f;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.delete-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}
