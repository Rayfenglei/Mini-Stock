/* ============================================
   首页样式 - 现代金融投资风格
   ============================================ */

/* ---------- 顶部欢迎区域 ---------- */
.header-section {
  padding: 40rpx 32rpx 24rpx;
}

.user-greeting {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.greeting-text {
  display: flex;
  flex-direction: column;
}

.greeting-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.greeting-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.notification-btn {
  width: 80rpx;
  height: 80rpx;
  background: var(--bg-secondary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.notification-btn:active {
  background: var(--gray-100);
}

.notification-icon {
  font-size: 36rpx;
}

.notification-dot {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--error);
  border-radius: 50%;
  border: 2rpx solid var(--bg-secondary);
}

/* ---------- 总资产卡片 ---------- */
.asset-card {
  margin: 0 32rpx 32rpx;
  padding: 40rpx 36rpx;
  position: relative;
  overflow: hidden;
}

.asset-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.asset-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.asset-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.time-selector {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
}

.time-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-right: 8rpx;
}

.time-arrow {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.asset-value-section {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.asset-currency {
  font-size: 40rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  margin-right: 8rpx;
  margin-top: 8rpx;
}

.asset-amount {
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
  line-height: 1;
}

.asset-change-section {
  margin-bottom: 32rpx;
}

.change-badge {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.change-badge.up {
  background: rgba(239, 68, 68, 0.2);
  color: #fff;
}

.change-badge.down {
  background: rgba(16, 185, 129, 0.2);
  color: #fff;
}

.change-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
}

.change-value {
  margin-right: 8rpx;
}

.change-rate {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 迷你趋势图 */
.mini-chart {
  height: 120rpx;
  margin-top: 16rpx;
  position: relative;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

/* ---------- 快捷操作区 ---------- */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx;
  margin: 0 32rpx 32rpx;
  background: var(--bg-secondary);
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
}

.action-item:active {
  opacity: 0.7;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  font-size: 36rpx;
}

.action-icon.add {
  background: linear-gradient(135deg, var(--primary-500) 0%, var(--primary-600) 100%);
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
}

.action-icon.analysis {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
}

.action-icon.transaction {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
}

.action-icon.settings {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
}

.action-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* ---------- 投资组合标题 ---------- */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 16rpx;
}

.section-title-group {
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.sort-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: var(--primary-50);
  border-radius: 24rpx;
}

.sort-btn:active {
  background: var(--primary-100);
}

.sort-text {
  font-size: 24rpx;
  color: var(--primary-600);
  font-weight: 500;
  margin-right: 8rpx;
}

.sort-icon {
  font-size: 20rpx;
  color: var(--primary-600);
}

/* ---------- 持仓列表 ---------- */
.holdings-list {
  padding: 0 24rpx;
}

/* 表头 */
.holdings-header {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  margin-bottom: 0;
  border-bottom: 2rpx solid var(--gray-200);
}

.header-col {
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.header-col.qty-col,
.header-col.price-col {
  justify-content: center;
}

.header-col.profit-col {
  justify-content: flex-end;
}

.header-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.header-sub {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.header-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-left: 8rpx;
}

/* 列宽定义 - 使用百分比确保对齐 */
.name-col {
  width: 28%;
  min-width: 0;
}

.qty-col {
  width: 18%;
  text-align: center;
}

.price-col {
  width: 24%;
  text-align: center;
}

.profit-col {
  width: 30%;
  text-align: right;
}

.holding-item-wrapper {
  position: relative;
  overflow: hidden;
}

.delete-action {
  position: absolute;
  right: 0;
  top: 0;
  width: 160rpx;
  height: 100%;
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.delete-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.holding-item {
  position: relative;
  background: var(--bg-secondary);
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  z-index: 2;
  will-change: transform;
  border-bottom: 1rpx solid var(--gray-100);
}

.holding-item.animating {
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.holding-item:last-child {
  border-bottom: 1rpx solid var(--gray-200);
}

/* 列样式 */
.col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.col.qty-col,
.col.price-col {
  align-items: center;
}

.col.profit-col {
  align-items: flex-end;
}

/* 名称/市值列 */
.name-col .name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.stock-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-right: 8rpx;
}

.market-tag {
  font-size: 20rpx;
  color: var(--primary-500);
  border: 1rpx solid var(--primary-200);
  border-radius: 4rpx;
  padding: 2rpx 6rpx;
}

.market-value {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 持仓/可用列 */
.qty-col .qty-value {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.qty-col .qty-available {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 现价/成本列 */
.price-col .current-price {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.price-col .cost-price {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* 浮动盈亏列 */
.profit-col .profit-amount {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.profit-col .profit-rate {
  font-size: 26rpx;
  font-weight: 500;
}

/* 涨跌颜色 */
.up {
  color: var(--rise-color);
}

.down {
  color: var(--fall-color);
}

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
  margin: 0 32rpx;
  background: var(--bg-secondary);
  border-radius: 24rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, var(--primary-100) 0%, var(--primary-200) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* ---------- 浮动按钮 ---------- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--primary-500) 0%, var(--primary-600) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4), 0 0 20rpx rgba(59, 130, 246, 0.3);
  z-index: 100;
}

.fab:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}
