/* ============================================
   首页样式 - 现代金融投资风格
   ============================================ */

/* ---------- 顶部欢迎区域 ---------- */
.header-section {
  padding: 40rpx 32rpx 24rpx;
}

.user-greeting {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.greeting-text {
  display: flex;
  flex-direction: column;
}

.greeting-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.greeting-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.notification-btn {
  width: 80rpx;
  height: 80rpx;
  background: var(--bg-secondary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.notification-btn:active {
  background: var(--gray-100);
}

.notification-icon {
  font-size: 36rpx;
}

.notification-dot {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 16rpx;
  height: 16rpx;
  background: var(--error);
  border-radius: 50%;
  border: 2rpx solid var(--bg-secondary);
}

/* ---------- 总资产卡片 ---------- */
.asset-card {
  margin: 0 32rpx 32rpx;
  padding: 40rpx 36rpx;
  position: relative;
  overflow: hidden;
}

.asset-card::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.asset-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.asset-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 500;
}

.time-selector {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
}

.time-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-right: 8rpx;
}

.time-arrow {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

.asset-value-section {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.asset-currency {
  font-size: 40rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
  margin-right: 8rpx;
  margin-top: 8rpx;
}

.asset-amount {
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
  line-height: 1;
}

.asset-change-section {
  margin-bottom: 32rpx;
}

.change-badge {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.change-badge.up {
  background: rgba(239, 68, 68, 0.2);
  color: #fff;
}

.change-badge.down {
  background: rgba(16, 185, 129, 0.2);
  color: #fff;
}

.change-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
}

.change-value {
  margin-right: 8rpx;
}

.change-rate {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 迷你趋势图 */
.mini-chart {
  height: 120rpx;
  margin-top: 16rpx;
  position: relative;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

/* ---------- 快捷操作区 ---------- */
.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 32rpx;
  margin: 0 32rpx 32rpx;
  background: var(--bg-secondary);
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
}

.action-item:active {
  opacity: 0.7;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  font-size: 36rpx;
}

.action-icon.add {
  background: linear-gradient(135deg, var(--primary-500) 0%, var(--primary-600) 100%);
  color: #fff;
  font-size: 48rpx;
  font-weight: 300;
}

.action-icon.analysis {
  background: linear-gradient(135deg, #8B5CF6 0%, #7C3AED 100%);
}

.action-icon.transaction {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
}

.action-icon.settings {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
}

.action-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* ---------- 投资组合标题 ---------- */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx 16rpx;
}

/* 头部操作区 */
.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 刷新按钮 */
.refresh-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: var(--bg-secondary);
  border-radius: 24rpx;
  transition: all 0.3s ease;
}

.refresh-btn:active {
  background: var(--gray-100);
  transform: scale(0.98);
}

.refresh-btn.refreshing {
  background: var(--primary-50);
  opacity: 0.8;
}

.refresh-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.refresh-text {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.refresh-btn.refreshing .refresh-text {
  color: var(--primary-600);
}

/* 刷新动画 */
@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.refresh-btn.refreshing .refresh-icon {
  animation: rotate 1s linear infinite;
}

/* 缓存统计 */
.cache-stats {
  padding: 8rpx 32rpx;
  text-align: right;
}

.cache-stats-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

/* ---------- 资产类型切换标签 ---------- */
.tab-nav {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16rpx 32rpx 24rpx;
  gap: 16rpx;
}

.tab-item {
  flex: 1;
  max-width: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 32rpx;
  background: var(--bg-secondary);
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.tab-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, var(--primary-500) 0%, var(--primary-600) 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
  border-radius: 30rpx;
}

.tab-item.active::before {
  opacity: 1;
}

.tab-item.active {
  border-color: var(--primary-500);
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.3);
}

.tab-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
  transition: color 0.3s ease;
  position: relative;
  z-index: 1;
}

.tab-item.active .tab-text {
  color: #fff;
  font-weight: 600;
}

/* 悬停效果 - 使用 active 模拟 */
.tab-item:active {
  transform: scale(0.98);
  background: var(--gray-100);
}

.tab-item.active:active {
  transform: scale(0.98);
  background: transparent;
}

/* 响应式布局 - 小屏幕适配 */
@media screen and (max-width: 375px) {
  .tab-nav {
    padding: 12rpx 24rpx 20rpx;
    gap: 12rpx;
  }
  
  .tab-item {
    padding: 16rpx 24rpx;
    max-width: 160rpx;
  }
  
  .tab-text {
    font-size: 26rpx;
  }
}

/* 响应式布局 - 大屏幕适配 */
@media screen and (min-width: 768px) {
  .tab-nav {
    justify-content: flex-start;
    padding: 20rpx 32rpx 28rpx;
  }
  
  .tab-item {
    max-width: 180rpx;
    padding: 24rpx 40rpx;
  }
  
  .tab-text {
    font-size: 30rpx;
  }
}

.section-title-group {
  display: flex;
  flex-direction: column;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.sort-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: var(--primary-50);
  border-radius: 24rpx;
}

.sort-btn:active {
  background: var(--primary-100);
}

.sort-text {
  font-size: 24rpx;
  color: var(--primary-600);
  font-weight: 500;
  margin-right: 8rpx;
}

.sort-icon {
  font-size: 20rpx;
  color: var(--primary-600);
}

/* ---------- 持仓列表 ---------- */
.holdings-list {
  padding: 0 24rpx;
  animation: fadeInUp 0.3s ease-out;
}

/* 内容切换动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.stock-content,
.fund-content,
.gold-content {
  animation: fadeInUp 0.3s ease-out;
}

/* 标签页空状态 */
.tab-empty {
  margin: 32rpx;
  padding: 60rpx 48rpx;
}

.tab-empty .empty-icon {
  width: 120rpx;
  height: 120rpx;
  font-size: 60rpx;
  background: linear-gradient(135deg, var(--gray-100) 0%, var(--gray-200) 100%);
}

/* 表头 - 统一布局系统 */
.holdings-header {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  margin-bottom: 0;
  border-bottom: 2rpx solid var(--gray-200);
}

/* 股票表头布局 - 4列 */
.stock-header {
  display: grid;
  grid-template-columns: 28% 18% 24% 30%;
  gap: 0;
}

/* 基金表头布局 - 3列 */
.fund-header {
  display: grid;
  grid-template-columns: 45% 30% 25%;
  gap: 0;
}

/* 黄金表头布局 - 3列 */
.gold-header {
  display: grid;
  grid-template-columns: 40% 30% 30%;
  gap: 0;
}

/* 表头单元格 */
.header-cell {
  display: flex;
  align-items: center;
  font-size: 26rpx;
}

.header-name {
  justify-content: flex-start;
}

.header-center {
  justify-content: center;
}

.header-right {
  justify-content: flex-end;
}

.header-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.header-sub {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.header-arrow {
  font-size: 28rpx;
  color: var(--text-tertiary);
  margin-left: 8rpx;
}

/* 兼容旧样式 - 股票 */
.name-col { width: 28%; min-width: 0; }
.qty-col { width: 18%; text-align: center; }
.price-col { width: 24%; text-align: center; }
.profit-col { width: 30%; text-align: right; }

/* 兼容旧样式 - 基金 */
.fund-name-col { width: 45%; min-width: 0; }
.fund-amount-col { width: 30%; text-align: center; }
.fund-profit-col { width: 25%; text-align: right; }

/* 兼容旧样式 - 黄金 */
.gold-name-col { width: 40%; min-width: 0; }
.gold-weight-col { width: 30%; text-align: center; }
.gold-price-col { width: 30%; text-align: right; }

.holding-item-wrapper {
  position: relative;
  overflow: hidden;
}

.delete-action {
  position: absolute;
  right: 0;
  top: 0;
  width: 160rpx;
  height: 100%;
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1;
}

.delete-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

/* 列表项 - 统一布局系统 */
.holding-item {
  position: relative;
  background: var(--bg-secondary);
  padding: 28rpx 0;
  z-index: 2;
  will-change: transform;
  border-bottom: 1rpx solid var(--gray-100);
}

.holding-item.animating {
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.holding-item:last-child {
  border-bottom: 1rpx solid var(--gray-200);
}

/* 股票列表项 - 4列网格 */
.stock-item {
  display: grid;
  grid-template-columns: 28% 18% 24% 30%;
  gap: 0;
  align-items: center;
}

/* 基金列表项 - 3列网格 */
.fund-item {
  display: grid;
  grid-template-columns: 45% 30% 25%;
  gap: 0;
  align-items: center;
}

/* 黄金列表项 - 3列网格 */
.gold-item {
  display: grid;
  grid-template-columns: 40% 30% 30%;
  gap: 0;
  align-items: center;
}

/* 单元格基础样式 */
.cell {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 0 8rpx;
}

.cell-name {
  align-items: flex-start;
  padding-left: 0;
}

.cell-center {
  align-items: center;
  text-align: center;
}

.cell-right {
  align-items: flex-end;
  text-align: right;
  padding-right: 0;
}

/* 名称样式 - 两行截断 */
.asset-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.4;

  /* 核心：两行省略 */
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2; /* 行数：2 */
  -webkit-box-orient: vertical;
  text-overflow: ellipsis;
  word-break: break-all; /* 强制换行，避免长英文/数字不折行 */
}

/* 名称行（带标签） */
.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  max-width: 100%;
  margin-bottom: 8rpx;
}

.name-row .asset-name {
  flex: 1; /* 占满剩余空间，最稳定 */
  min-width: 0;
}

.market-tag {
  font-size: 20rpx;
  color: var(--primary-500);
  border: 1rpx solid var(--primary-200);
  border-radius: 4rpx;
  padding: 2rpx 6rpx;
  flex-shrink: 0;
}

/* 数值组样式 */
.value-group {
  display: flex;
  flex-direction: column;
  align-items: inherit;
  gap: 8rpx;
}

.amount-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

/* 主要数值 */
.primary-value {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  line-height: 1.2;
}

/* 次要数值 */
.secondary-value {
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.2;
}

/* 子数值（市值等） */
.sub-value {
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.2;
}

/* 收益率数值 */
.rate-value {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
}

/* 兼容旧样式 */
.col {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.col.qty-col,
.col.price-col {
  align-items: center;
}

.col.profit-col {
  align-items: flex-end;
}

.stock-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-right: 8rpx;
}

.market-value {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.qty-col .qty-value {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.qty-col .qty-available {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.price-col .current-price {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.price-col .cost-price {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.profit-col .profit-amount {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.profit-col .profit-rate {
  font-size: 26rpx;
  font-weight: 500;
}

/* 基金列表兼容样式 */
.fund-item .col.fund-amount-col {
  align-items: center;
}

.fund-item .col.fund-profit-col {
  align-items: flex-end;
}

.fund-amount {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.fund-daily-profit {
  font-size: 26rpx;
  font-weight: 500;
}

.fund-profit-rate {
  font-size: 26rpx;
  font-weight: 500;
}

/* 黄金列表兼容样式 */
.gold-item .col.gold-weight-col {
  align-items: center;
}

.gold-item .col.gold-price-col {
  align-items: flex-end;
}

.gold-weight {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.gold-price {
  font-size: 32rpx;
  font-weight: 600;
}

/* 涨跌颜色 */
.up {
  color: var(--rise-color);
}

.down {
  color: var(--fall-color);
}

/* ---------- 空状态 ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
  margin: 0 32rpx;
  background: var(--bg-secondary);
  border-radius: 24rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, var(--primary-100) 0%, var(--primary-200) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
}

/* ---------- 浮动按钮 ---------- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  background: linear-gradient(135deg, var(--primary-500) 0%, var(--primary-600) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.4), 0 0 20rpx rgba(59, 130, 246, 0.3);
  z-index: 100;
}

.fab:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}
