<view class="container">
  <!-- 顶部欢迎区域 -->
  <view class="header-section">
    <view class="user-greeting">
      <view class="greeting-text">
        <text class="greeting-label">Hi {{userName || '投资者'}}</text>
        <text class="greeting-title">欢迎回来</text>
      </view>
      <view class="notification-btn" bindtap="onNotificationTap">
        <text class="notification-icon">🔔</text>
        <view wx:if="{{hasNotification}}" class="notification-dot"></view>
      </view>
    </view>
  </view>

  <!-- 总资产卡片 -->
  <view class="asset-card card-gradient">
    <view class="asset-card-header">
      <text class="asset-label">总资产估值</text>
      <view class="time-selector" bindtap="onTimeSelectorTap">
        <text class="time-text">{{timeRange}}</text>
        <text class="time-arrow">▼</text>
      </view>
    </view>
    <view class="asset-value-section">
      <text class="asset-currency">¥</text>
      <text class="asset-amount">{{totalAssetsDisplay}}</text>
    </view>
    <view class="asset-change-section">
      <view class="change-badge {{totalProfit >= 0 ? 'up' : 'down'}}">
        <text class="change-icon">{{totalProfit >= 0 ? '▲' : '▼'}}</text>
        <text class="change-value">{{totalProfit >= 0 ? '+' : ''}}{{totalProfitDisplay}}</text>
        <text class="change-rate">({{totalProfit >= 0 ? '+' : ''}}{{totalProfitRateDisplay}}%)</text>
      </view>
    </view>
    
    <!-- 迷你趋势图 -->
    <view class="mini-chart">
      <canvas type="2d" id="trendChart" class="chart-canvas"></canvas>
    </view>
  </view>

  <!-- 快捷操作区 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="onAddAssetTap">
      <view class="action-icon add">
        <text>+</text>
      </view>
      <text class="action-label">添加资产</text>
    </view>
    <view class="action-item" bindtap="onAnalysisTap">
      <view class="action-icon analysis">
        <text>📊</text>
      </view>
      <text class="action-label">资产分析</text>
    </view>
    <view class="action-item" bindtap="onTransactionTap">
      <view class="action-icon transaction">
        <text>📝</text>
      </view>
      <text class="action-label">交易记录</text>
    </view>
    <view class="action-item" bindtap="onSettingsTap">
      <view class="action-icon settings">
        <text>⚙️</text>
      </view>
      <text class="action-label">设置</text>
    </view>
  </view>

  <!-- 投资组合标题 -->
  <view class="section-header">
    <view class="section-title-group">
      <text class="section-title">我的投资组合</text>
      <text class="section-subtitle">{{holdings.length}} 个持仓</text>
    </view>
    <view class="sort-btn" bindtap="onSortTap">
      <text class="sort-text">{{sortType === 'value' ? '按市值' : sortType === 'profit' ? '按盈亏' : '按名称'}}</text>
      <text class="sort-icon">{{sortAsc ? '↑' : '↓'}}</text>
    </view>
  </view>

  <!-- 资产类型切换标签 -->
  <view class="tab-nav">
    <view 
      class="tab-item {{activeTab === 'stock' ? 'active' : ''}}" 
      bindtap="onTabChange" 
      data-type="stock"
    >
      <text class="tab-text">股票</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'fund' ? 'active' : ''}}" 
      bindtap="onTabChange" 
      data-type="fund"
    >
      <text class="tab-text">基金</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'gold' ? 'active' : ''}}" 
      bindtap="onTabChange" 
      data-type="gold"
    >
      <text class="tab-text">黄金</text>
    </view>
  </view>

  <!-- 持仓列表 -->
  <view class="holdings-list {{activeTab}}-content" wx:if="{{holdings.length > 0}}">
    <!-- 表头 -->
    <view class="holdings-header">
      <view class="header-col name-col">
        <text class="header-text">名称</text>
        <text class="header-sub">/市值</text>
      </view>
      <view class="header-col qty-col">
        <text class="header-text">持仓</text>
        <text class="header-sub">/可用</text>
      </view>
      <view class="header-col price-col">
        <text class="header-text">现价</text>
        <text class="header-sub">/成本</text>
      </view>
      <view class="header-col profit-col">
        <text class="header-text">浮动盈亏</text>
        <text class="header-arrow">›</text>
      </view>
    </view>

    <view 
      class="holding-item-wrapper" 
      wx:for="{{holdings}}" 
      wx:key="_id"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      data-index="{{index}}"
    >
      <!-- 删除按钮 -->
      <view class="delete-action" bindtap="onDeleteTap" data-id="{{item._id}}">
        <text class="delete-text">删除</text>
      </view>
      
      <!-- 持仓行 -->
      <view 
        class="holding-item {{item.animating ? 'animating' : ''}}"
        style="transform: translateX({{item.translateX || 0}}px)"
        bindtap="onHoldingTap"
        data-id="{{item._id}}"
        data-index="{{index}}"
      >
        <!-- 名称/市值列 -->
        <view class="col name-col">
          <view class="name-row">
            <text class="stock-name">{{item.assetName}}</text>
            <text class="market-tag" wx:if="{{item.market}}">{{item.market}}</text>
          </view>
          <text class="market-value">{{item.marketValueDisplay}}</text>
        </view>

        <!-- 持仓/可用列 -->
        <view class="col qty-col">
          <text class="qty-value">{{item.sharesDisplay}}</text>
          <text class="qty-available">{{item.sharesDisplay}}</text>
        </view>

        <!-- 现价/成本列 -->
        <view class="col price-col">
          <text class="current-price {{item.todayChange >= 0 ? 'up' : 'down'}}">{{item.currentPriceDisplay}}</text>
          <text class="cost-price">{{item.costPriceDisplay}}</text>
        </view>

        <!-- 浮动盈亏列 -->
        <view class="col profit-col">
          <text class="profit-amount {{item.profit >= 0 ? 'up' : 'down'}}">
            {{item.profit >= 0 ? '+' : ''}}{{item.profitDisplay}}
          </text>
          <text class="profit-rate {{item.profitRate >= 0 ? 'up' : 'down'}}">
            {{item.profitRate >= 0 ? '+' : ''}}{{item.profitRateDisplay}}%
          </text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{holdings.length === 0}}" class="empty-state">
    <view class="empty-icon">📈</view>
    <text class="empty-title">暂无持仓</text>
    <text class="empty-desc">点击下方按钮添加您的第一笔投资</text>
    <button class="btn btn-primary btn-sm" style="margin-top: 40rpx; width: 240rpx;" bindtap="onAddAssetTap">
      添加资产
    </button>
  </view>

  <!-- 当前类型无持仓 -->
  <view wx:else class="empty-state tab-empty">
    <view class="empty-icon">📊</view>
    <text class="empty-title">暂无{{activeTab === 'stock' ? '股票' : activeTab === 'fund' ? '基金' : '黄金'}}持仓</text>
    <text class="empty-desc">切换到其他类型查看持仓或添加新资产</text>
  </view>

  <!-- 底部间距 -->
  <view style="height: 40rpx;"></view>
</view>

<!-- 浮动添加按钮 -->
<view class="fab" bindtap="onAddAssetTap">
  <text class="fab-icon">+</text>
</view>
