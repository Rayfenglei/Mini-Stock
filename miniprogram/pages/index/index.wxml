<view class="container">
  <view class="total-assets-card">
    <view class="assets-header">
      <text class="assets-title">总资产概览</text>
    </view>
    <view class="assets-body">
      <view class="assets-item">
        <text class="assets-label">总投入</text>
        <text class="assets-value">¥{{totalInvestmentDisplay}}</text>
      </view>
      <view class="assets-divider"></view>
      <view class="assets-item">
        <text class="assets-label">总盈亏</text>
        <text class="assets-value {{totalProfit >= 0 ? 'profit' : 'loss'}}">
          {{totalProfit >= 0 ? '+' : ''}}¥{{totalProfitDisplay}}
        </text>
      </view>
    </view>
  </view>

  <view class="add-asset-btn-wrapper">
    <view class="add-asset-btn" bindtap="onAddAssetTap">
      <view class="add-icon">+</view>
      <text class="add-text">添加资产</text>
    </view>
  </view>

  <view class="recent-holdings" wx:if="{{recentHoldings.length > 0}}">
    <view class="section-header">
      <text class="section-title">我的持有</text>
      <view class="sort-btn">
        <text class="sort-text">金额排序</text>
      </view>
    </view>
    <view class="holding-card-wrapper" wx:for="{{recentHoldings}}" wx:key="_id" bindtap="onWrapperTap" data-index="{{index}}">
      <view class="delete-btn" bindtap="onDeleteTap" data-id="{{item._id}}" data-index="{{index}}">
        <text class="delete-text">删除</text>
      </view>
      <view class="holding-card {{item.animating ? 'animating' : ''}}" 
            style="transform: translateX({{item.translateX || 0}}px)"
            bindtouchstart="onTouchStart" 
            bindtouchmove="onTouchMove" 
            bindtouchend="onTouchEnd"
            catchtap="onCardTap"
            data-index="{{index}}"
            data-id="{{item._id}}">
        <view class="card-accent-bar" style="background: {{item.profit >= 0 ? 'linear-gradient(135deg, #52c41a 0%, #73d13d 100%)' : 'linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%)'}}"></view>
        <view class="holding-content">
          <view class="card-header">
            <view class="asset-identity">
              <text class="asset-name">{{item.assetName}}</text>
              <text class="asset-code">{{item.assetCode}}</text>
            </view>
            <view class="update-badge">
              <text class="update-text">今日收益更新</text>
            </view>
          </view>
          
          <view class="main-metrics">
            <view class="metric-group">
              <text class="metric-label">总金额</text>
              <text class="metric-value primary {{item.profit >= 0 ? 'profit' : 'loss'}}">¥{{item.marketValueDisplay}}</text>
            </view>
            <view class="metric-group today-profit">
              <text class="metric-label">今日收益（元）</text>
              <view class="today-profit-value">
                <text class="metric-value {{item.todayProfit >= 0 ? 'profit' : 'loss'}}">{{item.todayProfit >= 0 ? '+' : ''}}¥{{item.todayProfitDisplay}}</text>
                <text class="metric-rate {{item.todayProfitRate >= 0 ? 'profit' : 'loss'}}">{{item.todayProfitRate >= 0 ? '+' : ''}}{{item.todayProfitRateDisplay}}%</text>
              </view>
            </view>
          </view>
          
          <view class="divider-dotted"></view>
          
          <view class="detail-metrics">
            <view class="detail-item">
              <text class="detail-label">持仓成本</text>
              <text class="detail-value">¥{{item.costAmountDisplay}}</text>
              <view class="profit-bar">
                <view class="profit-bar-fill" style="width: {{item.profitBarWidth}}%; background: {{item.profit >= 0 ? '#52c41a' : '#ff4d4f'}}"></view>
              </view>
            </view>
            <view class="detail-item">
              <text class="detail-label">成本价</text>
              <text class="detail-value">{{item.costPriceDisplay}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">现价</text>
              <text class="detail-value">{{item.currentPriceDisplay}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">持有份额</text>
              <text class="detail-value">{{item.sharesDisplay}}</text>
            </view>
            <view class="detail-item">
              <text class="detail-label">总盈亏</text>
              <text class="detail-value {{item.profit >= 0 ? 'profit' : 'loss'}}">{{item.profit >= 0 ? '+' : ''}}¥{{item.profitDisplay}}</text>
              <text class="detail-rate {{item.profitRate >= 0 ? 'profit' : 'loss'}}">{{item.profitRate >= 0 ? '+' : ''}}{{item.profitRateDisplay}}%</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <text class="empty-text">暂无持仓记录</text>
    <text class="empty-desc">点击上方按钮添加您的第一个金融资产</text>
  </view>
</view>
