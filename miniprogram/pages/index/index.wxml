<view class="container">
  <!-- 顶部欢迎区域 -->
  <view class="header-section">
    <view class="user-greeting">
      <view class="greeting-text">
        <text class="greeting-label">Hi {{userName || '投资者'}}</text>
        <text class="greeting-title">欢迎回来</text>
      </view>
      <view class="notification-btn" bindtap="onNotificationTap">
        <text class="notification-icon">🔔</text>
        <view wx:if="{{hasNotification}}" class="notification-dot"></view>
      </view>
    </view>
  </view>

  <!-- 总资产卡片 -->
  <view class="asset-card card-gradient">
    <view class="asset-card-header">
      <text class="asset-label">总资产估值</text>
      <view class="time-selector" bindtap="onTimeSelectorTap">
        <text class="time-text">{{timeRange}}</text>
        <text class="time-arrow">▼</text>
      </view>
    </view>
    <view class="asset-value-section">
      <text class="asset-currency">¥</text>
      <text class="asset-amount">{{totalAssetsDisplay}}</text>
    </view>
    <view class="asset-change-section">
      <view class="change-badge {{totalProfit >= 0 ? 'up' : 'down'}}">
        <text class="change-icon">{{totalProfit >= 0 ? '▲' : '▼'}}</text>
        <text class="change-value">{{totalProfit >= 0 ? '+' : ''}}{{totalProfitDisplay}}</text>
        <text class="change-rate">({{totalProfit >= 0 ? '+' : ''}}{{totalProfitRateDisplay}}%)</text>
      </view>
    </view>

    <!-- 各类资产统计 -->
    <view class="asset-type-stats">
      <!-- 股票 -->
      <view class="asset-type-item">
        <view class="type-header">
          <text class="type-icon">📈</text>
          <text class="type-name">股票</text>
        </view>
        <text class="type-amount">{{stockTotalDisplay}}</text>
        <text class="type-rate {{stockProfitRate >= 0 ? 'up' : 'down'}}">
          {{stockProfitRate >= 0 ? '+' : ''}}{{stockProfitRateDisplay}}%
        </text>
      </view>
      <!-- 基金 -->
      <view class="asset-type-item">
        <view class="type-header">
          <text class="type-icon">📊</text>
          <text class="type-name">基金</text>
        </view>
        <text class="type-amount">{{fundTotalDisplay}}</text>
        <text class="type-rate {{fundProfitRate >= 0 ? 'up' : 'down'}}">
          {{fundProfitRate >= 0 ? '+' : ''}}{{fundProfitRateDisplay}}%
        </text>
      </view>
      <!-- 黄金 -->
      <view class="asset-type-item">
        <view class="type-header">
          <text class="type-icon">🥇</text>
          <text class="type-name">黄金</text>
        </view>
        <text class="type-amount">{{goldTotalDisplay}}</text>
        <text class="type-rate {{goldProfitRate >= 0 ? 'up' : 'down'}}">
          {{goldProfitRate >= 0 ? '+' : ''}}{{goldProfitRateDisplay}}%
        </text>
      </view>
    </view>

    <!-- 迷你趋势图 -->
    <!-- <view class="mini-chart">
      <canvas type="2d" id="trendChart" class="chart-canvas"></canvas>
    </view> -->
  </view>

  <!-- 快捷操作区 -->
  <view class="quick-actions">
    <view class="action-item" bindtap="onAddAssetTap">
      <view class="action-icon add">
        <text>+</text>
      </view>
      <text class="action-label">添加资产</text>
    </view>
    <view class="action-item" bindtap="onAnalysisTap">
      <view class="action-icon analysis">
        <text>📊</text>
      </view>
      <text class="action-label">资产分析</text>
    </view>
    <view class="action-item" bindtap="onTransactionTap">
      <view class="action-icon transaction">
        <text>📝</text>
      </view>
      <text class="action-label">交易记录</text>
    </view>
    <view class="action-item" bindtap="onSettingsTap">
      <view class="action-icon settings">
        <text>⚙️</text>
      </view>
      <text class="action-label">设置</text>
    </view>
  </view>

  <!-- 投资组合标题 -->
  <view class="section-header">
    <view class="section-title-group">
      <text class="section-title">我的投资组合</text>
      <text class="section-subtitle">{{holdings.length}} 个持仓</text>
    </view>
    <view class="header-actions">
      <!-- 刷新按钮 -->
      <view class="refresh-btn {{isRefreshing ? 'refreshing' : ''}}" bindtap="onRefreshTap">
        <text class="refresh-icon">{{isRefreshing ? '⏳' : '🔄'}}</text>
        <text class="refresh-text">{{isRefreshing ? '刷新中' : '刷新'}}</text>
      </view>
      <!-- 排序按钮 -->
      <view class="sort-btn" bindtap="onSortTap">
        <text class="sort-text">{{sortType === 'value' ? '按市值' : sortType === 'profit' ? '按盈亏' : '按名称'}}</text>
        <text class="sort-icon">{{sortAsc ? '↑' : '↓'}}</text>
      </view>
    </view>
  </view>

  <!-- 缓存统计信息（开发调试用，可隐藏） -->
  <view class="cache-stats" wx:if="{{cacheStats.totalRequests > 0}}">
    <text class="cache-stats-text">缓存命中率: {{cacheStats.hitRateFormatted}}</text>
  </view>

  <!-- 资产类型切换标签 -->
  <view class="tab-nav">
    <view 
      class="tab-item {{activeTab === 'stock' ? 'active' : ''}}" 
      bindtap="onTabChange" 
      data-type="stock"
    >
      <text class="tab-text">股票</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'fund' ? 'active' : ''}}" 
      bindtap="onTabChange" 
      data-type="fund"
    >
      <text class="tab-text">基金</text>
    </view>
    <view 
      class="tab-item {{activeTab === 'gold' ? 'active' : ''}}" 
      bindtap="onTabChange" 
      data-type="gold"
    >
      <text class="tab-text">黄金</text>
    </view>
  </view>

  <!-- 持仓列表 -->
  <view class="holdings-list {{activeTab}}-content" wx:if="{{holdings.length > 0}}">
    <!-- 股票表头 -->
    <view class="holdings-header stock-header" wx:if="{{activeTab === 'stock'}}">
      <view class="header-cell header-name">
        <text class="header-text">名称</text>
        <text class="header-sub">/市值</text>
      </view>
      <view class="header-cell header-center">
        <text class="header-text">持仓</text>
      </view>
      <view class="header-cell header-center">
        <text class="header-text">现价</text>
        <text class="header-sub">/成本</text>
      </view>
      <view class="header-cell header-right">
        <text class="header-text">浮动盈亏</text>
        <text class="header-arrow">›</text>
      </view>
    </view>

    <!-- 基金表头 -->
    <view class="holdings-header fund-header" wx:if="{{activeTab === 'fund'}}">
      <view class="header-cell header-name">
        <text class="header-text">名称</text>
      </view>
      <view class="header-cell header-center">
        <text class="header-text">金额</text>
        <text class="header-sub">/昨日收益</text>
      </view>
      <view class="header-cell header-right">
        <text class="header-text">持有收益率</text>
        <text class="header-arrow">›</text>
      </view>
    </view>

    <!-- 黄金表头 -->
    <view class="holdings-header gold-header" wx:if="{{activeTab === 'gold'}}">
      <view class="header-cell header-name">
        <text class="header-text">名称</text>
      </view>
      <view class="header-cell header-center">
        <text class="header-text">克重</text>
      </view>
      <view class="header-cell header-center">
        <text class="header-text">现价</text>
        <text class="header-sub">/成本</text>
      </view>
      <view class="header-cell header-right">
        <text class="header-text">浮动盈亏</text>
        <text class="header-arrow">›</text>
      </view>
    </view>

    <!-- 使用懒加载组件包装持仓项 -->
    <lazy-load
      wx:for="{{holdings}}"
      wx:key="_id"
      id="{{item._id}}"
      enabled="{{index >= 5}}"
      placeholderHeight="160rpx"
      showSkeleton="{{true}}"
      bindload="onLazyLoad"
    >
      <view
        class="holding-item-wrapper"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
        data-index="{{index}}"
      >
        <!-- 删除按钮 -->
        <view class="delete-action" bindtap="onDeleteTap" data-id="{{item._id}}">
          <text class="delete-text">删除</text>
        </view>

        <!-- 股票持仓行 -->
        <view
          wx:if="{{activeTab === 'stock'}}"
          class="holding-item stock-item {{item.animating ? 'animating' : ''}}"
          style="transform: translateX({{item.translateX || 0}}px)"
          bindtap="onHoldingTap"
          data-id="{{item._id}}"
          data-index="{{index}}"
        >
          <!-- 名称/市值列 -->
          <view class="cell cell-name">
            <view class="name-row">
              <text class="asset-name" decode="true">{{item.assetName}}</text>
              <text class="market-tag" wx:if="{{item.market}}">{{item.market}}</text>
            </view>
            <text class="sub-value">{{item.marketValueDisplay}}</text>
          </view>

          <!-- 持仓列 -->
          <view class="cell cell-center">
            <text class="primary-value">{{item.sharesDisplay}}</text>
          </view>

          <!-- 现价/成本列 -->
          <view class="cell cell-center">
            <view class="value-group">
              <text class="primary-value {{item.todayChange >= 0 ? 'up' : 'down'}}">{{item.currentPriceDisplay}}</text>
              <text class="secondary-value">{{item.costPriceDisplay}}</text>
            </view>
          </view>

          <!-- 浮动盈亏列 -->
          <view class="cell cell-right">
            <view class="value-group">
              <text class="primary-value {{item.profit >= 0 ? 'up' : 'down'}}">
                {{item.profit >= 0 ? '+' : ''}}{{item.profitDisplay}}
              </text>
              <text class="secondary-value {{item.profitRate >= 0 ? 'up' : 'down'}}">
                {{item.profitRate >= 0 ? '+' : ''}}{{item.profitRateDisplay}}%
              </text>
            </view>
          </view>
        </view>

        <!-- 基金持仓行 -->
        <view
          wx:if="{{activeTab === 'fund'}}"
          class="holding-item fund-item {{item.animating ? 'animating' : ''}}"
          style="transform: translateX({{item.translateX || 0}}px)"
          bindtap="onHoldingTap"
          data-id="{{item._id}}"
          data-index="{{index}}"
        >
          <!-- 名称列 -->
          <view class="cell cell-name">
            <text class="asset-name" decode="true">{{item.assetName}}</text>
          </view>

          <!-- 金额/昨日收益列 - 居中 -->
          <view class="cell cell-center">
            <view class="value-group">
              <text class="primary-value">{{item.marketValueDisplay}}</text>
              <text class="secondary-value {{item.todayProfit >= 0 ? 'up' : 'down'}}">
                {{item.todayProfit >= 0 ? '+' : ''}}{{item.todayProfitDisplay}}
              </text>
            </view>
          </view>

          <!-- 持有收益率列 - 靠右 -->
          <view class="cell cell-right">
            <text class="rate-value {{item.profitRate >= 0 ? 'up' : 'down'}}">
              {{item.profitRate >= 0 ? '+' : ''}}{{item.profitRateDisplay}}%
            </text>
          </view>
        </view>

        <!-- 黄金持仓行 -->
        <view
          wx:if="{{activeTab === 'gold'}}"
          class="holding-item gold-item {{item.animating ? 'animating' : ''}}"
          style="transform: translateX({{item.translateX || 0}}px)"
          bindtap="onHoldingTap"
          data-id="{{item._id}}"
          data-index="{{index}}"
        >
          <!-- 名称列 -->
          <view class="cell cell-name">
            <text class="asset-name" decode="true">{{item.assetName}}</text>
          </view>

          <!-- 克重列 -->
          <view class="cell cell-center">
            <text class="primary-value">{{item.sharesDisplay}}克</text>
          </view>

          <!-- 现价/成本列 -->
          <view class="cell cell-center">
            <view class="value-group">
              <text class="primary-value {{item.todayChange >= 0 ? 'up' : 'down'}}">{{item.currentPriceDisplay}}</text>
              <text class="secondary-value">{{item.costPriceDisplay}}</text>
            </view>
          </view>

          <!-- 浮动盈亏列 -->
          <view class="cell cell-right">
            <view class="value-group">
              <text class="primary-value {{item.profit >= 0 ? 'up' : 'down'}}">
                {{item.profit >= 0 ? '+' : ''}}{{item.profitDisplay}}
              </text>
              <text class="secondary-value {{item.profitRate >= 0 ? 'up' : 'down'}}">
                {{item.profitRate >= 0 ? '+' : ''}}{{item.profitRateDisplay}}%
              </text>
            </view>
          </view>
        </view>
      </view>
    </lazy-load>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{holdings.length === 0}}" class="empty-state">
    <view class="empty-icon">📈</view>
    <text class="empty-title">暂无持仓</text>
    <text class="empty-desc">点击下方按钮添加您的第一笔投资</text>
    <button class="btn btn-primary btn-sm" style="margin-top: 40rpx; width: 240rpx;" bindtap="onAddAssetTap">
      添加资产
    </button>
  </view>

  <!-- 当前类型无持仓 -->
  <view wx:else class="empty-state tab-empty">
    <view class="empty-icon">📊</view>
    <text class="empty-title">暂无{{activeTab === 'stock' ? '股票' : activeTab === 'fund' ? '基金' : '黄金'}}持仓</text>
    <text class="empty-desc">切换到其他类型查看持仓或添加新资产</text>
  </view>

</view>

<!-- 浮动添加按钮 -->
<view class="fab" bindtap="onAddAssetTap">
  <text class="fab-icon">+</text>
</view>
