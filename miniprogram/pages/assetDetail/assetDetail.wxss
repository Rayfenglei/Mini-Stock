.container {
  min-height: 100vh;
  background-color: #F5F6F7;
  padding-bottom: 120rpx;
}

.account-selector {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #fff;
}

.account-name {
  font-size: 32rpx;
  font-weight: bold;
  display: block;
}

.account-code {
  font-size: 24rpx;
  color: #999;
}

.edit-btn {
  font-size: 28rpx;
  color: #666;
  padding: 10rpx 20rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
}

.holdings-section {
  margin: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
}

.sort-btn {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: #E8F0FE;
  border-radius: 20rpx;
  font-size: 26rpx;
  color: #1A73E8;
}

.sort-icon {
  margin-left: 8rpx;
}

.empty-holdings {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  background: #fff;
  border-radius: 16rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #ccc;
}

.add-btn-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 40rpx;
  background: linear-gradient(to top, rgba(255,255,255,1) 70%, rgba(255,255,255,0));
}
