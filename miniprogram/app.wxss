page {
  --color-up: #E64340;
  --color-down: #00A650;
  --color-primary: #1A73E8;
  --color-primary-light: #E8F0FE;
  --color-success: #81C784;
  --color-warning: #FFB74D;
  --color-fund: #FF9800;
  --color-fund-bg: #FFF3E0;
  --color-gold: #FFD700;
  --color-gold-bg: #FFFDE7;
  --color-neutral: #9AA0A6;
  --bg-color: #F5F6F7;
  --card-bg: #FFFFFF;
  --divider-color: #EEEEEE;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-placeholder: #999999;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-color);
  box-sizing: border-box;
}

.container {
  min-height: 100vh;
  background-color: var(--bg-color);
  padding-bottom: 80rpx;
}

.up {
  color: var(--color-up);
}

.down {
  color: var(--color-down);
}

.text-primary {
  color: var(--color-primary);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-placeholder {
  color: var(--text-placeholder);
}

.card {
  margin: 20rpx;
  padding: 30rpx;
  background: var(--card-bg);
  border-radius: 16rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  background: var(--color-primary);
  color: white;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary::after {
  border: none;
}

.btn-success {
  width: 100%;
  height: 88rpx;
  background: var(--color-success);
  color: white;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-success::after {
  border: none;
}

.asset-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 10rpx;
}

.asset-tag-stock {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.asset-tag-fund {
  background: var(--color-fund-bg);
  color: var(--color-fund);
}

.asset-tag-gold {
  background: var(--color-gold-bg);
  color: var(--color-gold);
}
