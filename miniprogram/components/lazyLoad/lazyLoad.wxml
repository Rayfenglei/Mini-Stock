<view class="lazy-load-wrapper">
  <!-- 未加载状态：显示占位符或骨架屏 -->
  <view wx:if="{{!isLoaded}}" class="placeholder-container">
    <view wx:if="{{showSkeleton}}" class="skeleton" style="height: {{placeholderHeight}};">
      <view class="skeleton-header">
        <view class="skeleton-avatar"></view>
        <view class="skeleton-title"></view>
      </view>
      <view class="skeleton-content">
        <view class="skeleton-line"></view>
        <view class="skeleton-line"></view>
      </view>
    </view>
    <view wx:else class="simple-placeholder" style="height: {{placeholderHeight}};">
      <text class="placeholder-text">加载中...</text>
    </view>
  </view>

  <!-- 已加载状态：显示实际内容 -->
  <view wx:else class="content-container">
    <slot></slot>
  </view>
</view>
