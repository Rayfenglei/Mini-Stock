<view class="asset-selector">
  <view class="type-tabs">
    <view 
      class="tab {{currentType === 'stock' ? 'active' : ''}}" 
      bindtap="onTypeChange" 
      data-type="stock"
    >
      📈 股票
    </view>
    <view 
      class="tab {{currentType === 'fund' ? 'active' : ''}}" 
      bindtap="onTypeChange" 
      data-type="fund"
    >
      💰 基金
    </view>
    <view 
      class="tab {{currentType === 'gold' ? 'active' : ''}}" 
      bindtap="onTypeChange" 
      data-type="gold"
    >
      🥇 黄金
    </view>
  </view>


  <view wx:if="{{searchResults.length > 0}}" class="search-results">
    <view 
      class="result-item" 
      wx:for="{{searchResults}}" 
      wx:key="code"
      bindtap="onSelect"
      data-item="{{item}}"
    >
      <text class="result-name">{{item.name}}</text>
      <text class="result-code">{{item.code}}</text>
      <text class="result-price {{item.change >= 0 ? 'up' : 'down'}}">
        {{item.price}} {{item.change > 0 ? '+' : ''}}{{item.change}}%
      </text>
    </view>
  </view>


</view>
