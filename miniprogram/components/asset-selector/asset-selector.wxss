.asset-selector {
  padding: 20rpx;
}

.type-tabs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.tab.active {
  background: #E8F0FE;
  color: #1A73E8;
  font-weight: bold;
}

.search-box {
  margin-bottom: 20rpx;
}

.search-input {
  width: 100%;
  height: 80rpx;
  padding: 0 30rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.search-results, .gold-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.result-name {
  font-size: 28rpx;
  font-weight: bold;
  flex: 1;
}

.result-code {
  font-size: 24rpx;
  color: #999;
  margin: 0 20rpx;
}

.result-price {
  font-size: 26rpx;
  font-weight: bold;
}

.up { color: #E64340; }
.down { color: #00A650; }
