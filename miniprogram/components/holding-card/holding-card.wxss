.holding-card {
  margin: 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 16rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.asset-info {
  display: flex;
  align-items: center;
}

.asset-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-left: 10rpx;
}

.asset-code {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.update-tag {
  font-size: 20rpx;
  color: #999;
  padding: 6rpx 16rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
}

.card-main {
  display: flex;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.main-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}

.main-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.profit-row {
  display: flex;
  align-items: baseline;
}

.profit-value {
  font-size: 40rpx;
  font-weight: bold;
  margin-right: 10rpx;
}

.profit-rate {
  font-size: 28rpx;
}

.up { color: #E64340; }
.down { color: #00A650; }

.card-detail {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  padding: 20rpx 0;
}

.detail-item {
  display: flex;
  flex-direction: column;
}

.detail-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.detail-value {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.detail-rate {
  font-size: 22rpx;
  display: block;
  margin-top: 4rpx;
}

.extra-info {
  font-size: 22rpx;
  color: #999;
  padding: 10rpx 0;
}

.margin-left {
  margin-left: 20rpx;
}

.profit-bar {
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.profit-bar-fill {
  height: 100%;
  border-radius: 4rpx;
}

.profit-bar-fill.up { background: #E64340; }
.profit-bar-fill.down { background: #00A650; }
